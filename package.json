{
  "name": "deepseek-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated remote MCP bridge to DeepSeek with opt-in routing and persistent cost limits",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "start:stdio": "node --env-file-if-exists=.env dist/src/stdio.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "mock": "node dist/scripts/mock-deepseek.js",
    "init:local": "node dist/scripts/init-local-env.js",
    "smoke": "node --env-file-if-exists=.env dist/scripts/smoke-local.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
