# Local-only template. Use npm run init:local to generate a secret without printing it.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000/mcp
AUTH_MODE=bearer
MCP_BEARER_TOKEN=
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_ALLOWED_SUBJECTS=
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

DEEPSEEK_MODE=mock
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
MOCK_DEEPSEEK_URL=http://127.0.0.1:4010
ROUTING_ENABLED=false
ALLOW_PAID_REQUESTS=false

MAX_OUTPUT_TOKENS=2048
DEFAULT_OUTPUT_TOKENS=512
MAX_TOTAL_TOKENS=16384
MAX_INPUT_BYTES=12000
MAX_COST_PER_REQUEST_USD=0.02
DAILY_BUDGET_USD=0.10
TOTAL_BUDGET_USD=1
MAX_CALLS_PER_DAY=20
REQUEST_TIMEOUT_MS=30000
MAX_RESPONSE_BYTES=1048576
MAX_CONCURRENT_REQUESTS=2
LEDGER_PATH=data/budget.sqlite
